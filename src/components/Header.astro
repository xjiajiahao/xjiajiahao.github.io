---
import { isCurrent, withBase } from "../lib/url";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/articles/", label: "文章" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <a class="brand" href={withBase("/")} aria-label="谢bro的研究笔记首页">谢bro的研究笔记</a>

  <div class="header-actions">
    <nav aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            aria-current={isCurrent(pathname, link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a href={withBase("/rss.xml")}>RSS</a>
    </nav>

    <button class="theme-toggle" type="button" aria-label="切换深浅色主题" title="切换深浅色主题">
      <span class="theme-light" aria-hidden="true">☼</span>
      <span class="theme-dark" aria-hidden="true">☾</span>
    </button>
  </div>
</header>
