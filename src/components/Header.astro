---
const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/articles/", label: "文章" },
  { href: "/about/", label: "关于" },
];
---

<header class="site-header">
  <a class="brand" href="/" aria-label="谢bro的研究笔记首页">
    <span class="brand-mark" aria-hidden="true">谢</span>
    <span>
      <strong>谢bro</strong>
      <small>研究笔记</small>
    </span>
  </a>

  <nav aria-label="主导航">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={
            link.href === "/"
              ? pathname === "/"
                ? "page"
                : undefined
              : pathname.startsWith(link.href)
                ? "page"
                : undefined
          }
        >
          {link.label}
        </a>
      ))
    }
  </nav>

  <button class="theme-toggle" type="button" aria-label="切换深浅色主题">
    <span class="theme-icon" aria-hidden="true">◐</span>
  </button>
</header>
